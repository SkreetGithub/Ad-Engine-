# =============================================================================
# Addy Ad Engine — Environment variables
# =============================================================================
# Local:  cp .env.example .env.local  → fill values (never commit .env.local)
# Vercel: Project → Settings → Environment Variables → Import .env
#         Enable for: Production, Preview, Development (as needed)
# =============================================================================

# --- App URL (set on Vercel Production) ---
NEXT_PUBLIC_APP_URL=https://ad-engine-khaki.vercel.app

# --- OpenAI (required — Addy chat & Super Brain fallback) ---
OPENAI_API_KEY=

# --- Supabase (required on Vercel — persistence) ---
# Run supabase/schema.sql once in Supabase SQL Editor first
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# --- Cron auth (required Production — GitHub Actions + Vercel cron) ---
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Meta: Facebook ads, posts, sync ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=

# --- Cursor Cloud Agents (optional — technical / code questions) ---
# Dashboard → Integrations → User API Key (crsr_...)
# Uses https://api.cursor.com — NOT api.cursor.sh
CURSOR_API_KEY=
CURSOR_GITHUB_REPO_URL=https://github.com/SkreetGithub/Ad-Engine-

# --- Replicate video (optional) ---
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_VERSION=

# --- TikTok (optional) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- Competitive intel cron (optional) ---
SERPAPI_KEY=

# --- API hardening (optional — send header x-addy-secret from trusted clients) ---
ADDY_API_SECRET=

# --- Local Ollama instead of OpenAI (optional, dev only) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# --- Demo sample ads in workspace (optional — leave unset on production) ---
# ADDY_DEMO_SEED=true

# --- Supabase server-only (optional, do not expose to browser) ---
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# GitHub Actions OR Supabase pg_cron (pick one or both)
# Secrets: CRON_SECRET (required for any cron)
# Variables: VERCEL_APP_URL=https://ad-engine-khaki.vercel.app
#
# Supabase pg_cron: run supabase/optional-pg-cron.sql after schema.sql
#   → schedules /api/cron/addy-cycle every 6h + Meta sync every 3h
# =============================================================================
