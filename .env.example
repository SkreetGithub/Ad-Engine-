# Copy to .env.local and fill in your keys (never commit .env.local)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Meta Marketing API (for creating ads from website)
META_ACCESS_TOKEN=
# Ad account ID: use act_<number> (from Ads Manager URL or Business Settings → Ad Accounts). Not your Page ID.
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# Supabase — required on Vercel so Addy remembers companies, reviews, and lessons
# 1) Create project at supabase.com → SQL Editor → paste supabase/schema.sql (full file) → Run
# 2) Project Settings → API → copy URL + anon (public) key into Vercel env
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_from_project_settings_api
# Optional (server-only, never expose): Project Settings → API → service_role key, JWT secret for custom auth
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Optional: Replicate video model version (for POST /api/video/generate). Get from replicate.com.
REPLICATE_VIDEO_VERSION=

# Production (Vercel sets VERCEL_URL automatically; set this for custom domains)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Required in production: GitHub Actions + Vercel cron call optimize-ads with this secret
CRON_SECRET=

# GitHub Actions variable (not secret): VERCEL_APP_URL=https://ad-engine-khaki.vercel.app

# Addy production chat (required) — defaults to OpenAI when set
OPENAI_API_KEY=

# Meta — Facebook + Instagram (Page feed + optional IG user)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# TikTok Marketing API (optional)
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Demo sample ads in workspace only when true (production: leave unset)
# ADDY_DEMO_SEED=true

# Security: optional secret for API routes (x-addy-secret header). Set on Vercel in production.
# ADDY_API_SECRET=

# Competitive intel in daily cron (optional)
# SERPAPI_KEY=

# Cursor Cloud Agents API (Integrations → User API Key). NOT chat.completions — uses api.cursor.com
CURSOR_API_KEY=
CURSOR_GITHUB_REPO_URL=https://github.com/SkreetGithub/Ad-Engine-
